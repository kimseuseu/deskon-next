# Supabase (블로그·관리자·문의 모두 이 DB 를 씁니다)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 관리자 세션 서명키(권장). 없으면 SUPABASE_SERVICE_ROLE_KEY 를 대신 씁니다.
ADMIN_SESSION_SECRET=
# 통합 관리자 허브(admin-hub) 연동 키. 긴 무작위 문자열(예: openssl rand -hex 32)을 넣고,
# 허브의 사이트 수정 화면 "연동 키" 칸에 같은 값을 넣습니다. 비우면 /api/hub/export 는 항상 401 입니다.
HUB_API_TOKEN=
